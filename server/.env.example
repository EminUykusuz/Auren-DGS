# DB_TRUSTED_CONNECTION=true (veya DB_USER boş) → Windows Authentication
DB_SERVER=localhost
DB_PORT=1433
DB_TRUSTED_CONNECTION=true
DB_NAME=AurenDGS
DB_USER=
DB_PASSWORD=
JWT_SECRET=en-az-48-karakterlik-rastgele-bir-deger
PORT=5050
CORS_ORIGINS=https://auren-dgs-jiwm.vercel.app,http://localhost:5173
APP_URL=http://localhost:5050
NODE_ENV=development

# Geri bildirim e-postası (boşsa kayıtlar yalnızca veritabanında tutulur)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
FEEDBACK_TO=

# Çerez (HTTP VDS için COOKIE_SECURE=false; farklı site/Vercel için COOKIE_SAMESITE=none + HTTPS)
# COOKIE_SECURE=
# COOKIE_SAMESITE=strict
